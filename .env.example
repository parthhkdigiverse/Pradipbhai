# ===================================================
# ALPHA CREATIVE CRM/ERP CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ===================================================

# Port Settings (Configurable)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Credentials (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=alpha_creative_db

# Full SQLAlchemy Async MySQL Database Connection URL
DATABASE_URL=mysql+aiomysql://root:your_mysql_password@127.0.0.1:3306/alpha_creative_db

# Redis Caching URL
REDIS_URL=redis://127.0.0.1:6379/0

# FastAPI Backend Settings
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api
